# Server Configuration
PORT=3000

# CORS - Allowed origins (comma-separated)
# For development: http://localhost:8080,http://127.0.0.1:8080
# For production: https://bitglow.dev,https://www.bitglow.dev
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Email Configuration (SMTP)
# For Gmail:
#   - SMTP_HOST=smtp.gmail.com
#   - SMTP_PORT=587
#   - SMTP_SECURE=false
#   - SMTP_USER=your-email@gmail.com
#   - SMTP_PASS=your-app-password (NOT your regular password!)
#   - Get app password: https://myaccount.google.com/apppasswords
#
# For other providers (Outlook, Yahoo, SendGrid, etc.), use their SMTP settings

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=SMTP_USER: hello@bitglow.dev
SMTP_PASS=your-app-password-here

# Where to send contact form submissions
CONTACT_EMAIL=hello@bitglow.tech

# Auto-reply settings
# Set to 'false' to disable automatic reply to sender
SEND_AUTO_REPLY=true

# Admin Panel
# Generate hash: node -e "require('bcrypt').hash('your-password', 12).then(h => console.log(h))"
ADMIN_PASSWORD_HASH=
JWT_SECRET=change-this-to-a-long-random-string
